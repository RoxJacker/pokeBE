# Variables de entorno — Push Server PokePWA
# Copia este archivo como .env y rellena con las claves VAPID generadas.
# Ejecuta: node push-server.js  (la primera vez las genera automáticamente)

VAPID_PUBLIC_KEY=TU_CLAVE_PUBLICA_AQUI
VAPID_PRIVATE_KEY=TU_CLAVE_PRIVADA_AQUI
VAPID_MAILTO=mailto:admin@pokepwa.com
PORT=3001

MONGODB_URI="mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/pokepwa?appName=ClusterPokeAPI"
